---
const { title = 'Keratoconus — See What We See' } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white: #f5f5f0;
      --black: #0a0a0a;
      --accent: #00b4d8;
      --nav-h: 3.25rem;
    }

    html { scroll-behavior: auto; }

    body {
      background: var(--black);
      color: var(--white);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      overflow-x: hidden;
    }

    /* ── SKIP NAV ── */
    .skip-nav {
      position: fixed;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 9999;
      padding: 0.5em 1em;
      background: var(--accent);
      color: var(--black);
      font-weight: 700;
      font-size: 0.85rem;
      text-decoration: none;
      border-radius: 2px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s;
    }
    .skip-nav:focus-visible {
      opacity: 1;
      pointer-events: auto;
      outline: 2px solid var(--white);
      outline-offset: 3px;
    }

    /* ── SCREEN READER ONLY ── */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ── FOCUS ── */
    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    /* ── NAV ── */
    #site-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--nav-h);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2.25rem;
      background: rgba(10,10,10,0.92);
      backdrop-filter: blur(8px);
      transition: opacity 0.4s ease;
    }

    /* Home page: starts hidden, JS adds .nav-visible after vision section */
    #site-nav.nav-reveal {
      opacity: 0;
      pointer-events: none;
    }
    #site-nav.nav-reveal.nav-visible {
      opacity: 1;
      pointer-events: auto;
    }

    @media (prefers-reduced-motion: reduce) {
      #site-nav.nav-reveal {
        opacity: 1 !important;
        pointer-events: auto !important;
        transition: none;
      }
    }

    #site-nav a {
      font-size: 0.68rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--white);
      text-decoration: none;
      opacity: 0.7;
      transition: opacity 0.2s;
    }
    #site-nav a:hover { opacity: 1; }

    #site-nav a.active {
      color: var(--accent);
      opacity: 0.9;
    }

    #nav-links {
      display: flex;
      gap: 2rem;
    }

    /* ── FOOTER ── */
    footer {
      padding: 2rem;
      text-align: center;
      font-size: 0.75rem;
      color: rgba(245,245,240,0.55);
      border-top: 1px solid rgba(245,245,240,0.12);
    }
    footer a { color: rgba(245,245,240,0.55); }
    footer p + p { margin-top: 0.5rem; }

    /* ── CITE links — shared across all pages ── */
    a.cite {
      font-size: 0.68rem;
      color: var(--accent);
      opacity: 0.45;
      margin-left: 0.35em;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      white-space: nowrap;
      transition: opacity 0.15s;
    }
    a.cite:hover { opacity: 1; }
  </style>
  <slot name="head" />
</head>
<body>

  <a href="#main-content" class="skip-nav">Skip to content</a>

  <nav id="site-nav" class={isHome ? 'nav-reveal' : ''} aria-label="Site navigation">
    <a href="/">KC Awareness</a>
    <div id="nav-links">
      <a href="/about" class={path.startsWith('/about') ? 'active' : ''}>About</a>
      <a href="/advocacy" class={path.startsWith('/advocacy') ? 'active' : ''}>Advocacy</a>
    </div>
  </nav>

  <slot />

  <footer>
    <slot name="footer-extra" />
    <p>&copy; 2026 · Keratoconus awareness. Not medical advice.</p>
  </footer>


</body>
</html>
