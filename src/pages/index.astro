---
import Base from '../layouts/Base.astro';

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  CONTENT — edit text freely here
//  Don't touch anything below the closing ━━━ line.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

const hero = {
  heading: 'See What We See',
  body: 'Keratoconus affects an estimated 1 in every 300 persons, though the exact prevalence is unknown. And it is possible not to know it for years. Scroll to see a representation of it.',
};

const meta = {
  description: 'Experience an artistic representation of what vision with Keratoconus looks like as you scroll. Learn about resources.',
};

const vision = {
  labelNormal:   'Normal Vision',
  captionNormal: 'The world as most people see it: sharp, stable, and fully correctable.',
  labelKC:       'Keratoconus',
  captionKC:     "For someone with keratoconus, light scatters, halos form, and even the best glasses can't fully correct it.",
};

const what = {
  heading: 'When the cornea stops holding its shape',
  para1: 'Keratoconus (KC) is a progressive disorder where the cornea — normally a dome — gradually thins and bulges outward into a cone shape. As it distorts, it bends light incorrectly, causing blurred and distorted vision that worsens over years.',
  para2: 'It typically begins in the late teens or early twenties and can progress through the thirties. In severe cases, a corneal transplant becomes the only option. Caught early, specialty contact lenses and corneal cross-linking can slow or halt progression.',
};

// Add or remove cards by copying/deleting a { heading, body } object.
const symptoms = [
  { heading: 'Ghosting & doubling',          body: 'Multiple ghost images overlay a single object, especially under bright light.' },
  { heading: 'Halos & streaks',               body: 'Light sources bloom into starbursts and smeared streaks at night.' },
  { heading: "Blur that glasses can't fix",   body: 'Standard prescriptions stop correcting vision as the cone shape progresses.' },
  { heading: 'Light sensitivity',             body: 'Oncoming headlights, screens, and sunlight become overwhelming and painful.' },
  { heading: 'Frequent prescription changes', body: 'Rapid shifts in astigmatism that no single pair of glasses keeps up with.' },
  { heading: 'Eye rubbing',                   body: 'Chronic itching leads to rubbing — associated with accelerated corneal thinning.' },
];

const cta = {
  heading: 'Early diagnosis changes everything',
  body: "No website can diagnose eye diseases. If any of this looked familiar, talk to your eye doctor.",
};

const plots = {
  heading: 'Seeing it another way',
  intro: "That simulation was an approximation. Here's another attempt from during my recovery from corneal cross-linking surgery.",
  labelNormal: 'What most people see',
  captionNormal: 'Hopefully you only see one of each point.',
  labelKC: 'What I saw',
  captionKC: 'The same plot, as I saw it recovering from surgery. Every point, tripled.',
};

// Add sections here to insert prose between Symptoms and the CTA.
// Each section gets a small label, a heading, and as many paragraphs as you want.
// Leave this empty ([]) and nothing renders.
const extraSections: { label?: string; heading: string; paragraphs: string[] }[] = [
  // {
  //   label: 'My experience',
  //   heading: 'Living with KC',
  //   paragraphs: [
  //     'First paragraph...',
  //     'Second paragraph...',
  //   ],
  // },
];

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
---

<Base title="See Keratoconus" description={meta.description}>

  <style is:global>
    main#main-content { display: block; }
    main#main-content:focus { outline: none; }

    /* Mobile scroll-snap: each static content section becomes a "stop" so
       inertial swipes can't blow past a heading + paragraph in one flick.
       Proximity (not mandatory) so mid-section reading is not fought.
       The scrolly sections (#vision, #plots-pin) deliberately have no
       snap-align — GSAP needs free scroll inside them. */
    @media (max-width: 640px) {
      html {
        scroll-snap-type: y proximity;
        scroll-padding-top: var(--nav-h);
      }
    }
  </style>

  <style>
    /* ── VISION SECTION ── */
    #vision {
      position: relative;
      height: 700vh;
    }

    #vision-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vision-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ── hero overlay ── */
    #text-hero {
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      z-index: 10;
      text-align: center;
      pointer-events: auto;
      width: 90%;
      max-width: 700px;
      background: rgba(0,0,0,0.38);
      backdrop-filter: blur(6px);
      padding: 2.5rem 3rem;
      border-radius: 3px;
    }

    .hero-heading {
      font-size: clamp(2.8rem, 6vw, 5rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin-bottom: 1.25rem;
      text-shadow: 0 2px 40px rgba(0,0,0,0.98), 0 0 80px rgba(0,0,0,0.7);
    }

    .hero-sub {
      font-size: clamp(1rem, 1.8vw, 1.2rem);
      line-height: 1.7;
      color: rgba(245,245,240,0.88);
      text-shadow: 0 1px 20px rgba(0,0,0,0.98), 0 0 40px rgba(0,0,0,0.8);
    }

    .hero-sub .cite {
      color: var(--white);
      opacity: 1;
      border-bottom-color: rgba(245,245,240,0.9);
      text-shadow: 0 1px 12px rgba(0,0,0,0.98);
    }

    .hero-sub .cite:hover,
    .hero-sub .cite:focus-visible {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    /* ── KC caption overlay (appears after degradation) ── */
    .vision-text {
      position: absolute;
      top: calc(var(--nav-h) + 2.5rem);
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      text-align: center;
      pointer-events: none;
      width: 90%;
      max-width: 580px;
      background: rgba(0,0,0,0.52);
      backdrop-filter: blur(6px);
      padding: 1.5rem 2.5rem;
      border-radius: 2px;
    }

    #text-normal, #text-kc { opacity: 0; }

    .vision-eyebrow {
      font-size: 0.68rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      color: var(--accent);
    }

    .vision-desc {
      font-size: clamp(0.95rem, 1.5vw, 1.1rem);
      line-height: 1.75;
      color: rgba(245,245,240,0.85);
    }

    #scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: rgba(245,245,240,0.95);
      text-shadow: 0 1px 12px rgba(0,0,0,0.95), 0 0 24px rgba(0,0,0,0.75);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      pointer-events: none;
      animation: hintFadeIn 1.2s ease 0.4s both;
    }

    #scroll-hint .arrow {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, rgba(245,245,240,0.95), transparent);
      box-shadow: 0 0 8px rgba(0,0,0,0.7);
    }

    @keyframes hintFadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    /* ── WHAT IS KC ── */
    #what {
      padding: 12rem 2rem;
      max-width: 760px;
      margin: 0 auto;
    }

    .section-label {
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 2rem;
    }

    #what h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 2rem;
    }

    #what p {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.8;
      color: rgba(245,245,240,0.7);
      margin-bottom: 1.25rem;
    }

    /* ── SYMPTOMS ── */
    #symptoms {
      padding: 8rem 2rem;
      background: #111;
    }

    .symptoms-inner {
      max-width: 960px;
      margin: 0 auto;
    }

    #symptoms h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 3rem;
    }

    .symptom-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .symptom-card {
      padding: 1.75rem 1.5rem;
      border: 1px solid rgba(245,245,240,0.08);
      border-radius: 4px;
      opacity: 0;
      translate: 0 24px;
    }

    .symptom-card h3 {
      font-size: 1.05rem;
      margin-bottom: 0.6rem;
      color: var(--accent);
    }

    .symptom-card p {
      font-size: 0.92rem;
      line-height: 1.65;
      color: rgba(245,245,240,0.6);
    }

    /* ── EXTRA SECTIONS ── */
    .extra-section {
      padding: 10rem 2rem;
      max-width: 760px;
      margin: 0 auto;
    }

    .extra-section h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 2rem;
    }

    .extra-section p {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.8;
      color: rgba(245,245,240,0.7);
      margin-bottom: 1.25rem;
    }
    .extra-section p:last-child { margin-bottom: 0; }

    /* ── CTA ── */
    #cta {
      padding: 10rem 2rem;
      text-align: center;
    }

    #cta h2 {
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    #cta p {
      font-size: 1.05rem;
      color: rgba(245,245,240,0.6);
      margin-bottom: 2.5rem;
      line-height: 1.7;
    }

    .cta-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 0.85em 2em;
      background: var(--accent);
      color: var(--black);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.05em;
      border-radius: 2px;
      border: 1px solid transparent;
      transition: filter 0.4s ease, box-shadow 0.4s ease, background 0.3s ease, border-color 0.3s ease;
    }
    .btn:hover,
    .btn:focus-visible {
      filter: blur(0.8px);
      box-shadow:
        0 2px 8px   rgba(0,180,216,0.25),
        0 10px 28px rgba(0,180,216,0.18),
        0 28px 50px rgba(0,180,216,0.08);
    }

    .btn-ghost {
      background: transparent;
      color: var(--accent);
      border-color: rgba(0,180,216,0.55);
    }
    .btn-ghost:hover,
    .btn-ghost:focus-visible {
      filter: blur(0.5px);
      background: rgba(0,180,216,0.08);
      border-color: var(--accent);
      box-shadow:
        0 2px 8px  rgba(0,180,216,0.18),
        0 10px 28px rgba(0,180,216,0.10);
    }

    @media (prefers-reduced-motion: reduce) {
      .btn:hover,
      .btn:focus-visible {
        filter: none;
        box-shadow: 0 0 24px rgba(0,180,216,0.5);
      }
      .btn-ghost:hover,
      .btn-ghost:focus-visible {
        filter: none;
        box-shadow: 0 0 18px rgba(0,180,216,0.3);
      }
    }

    /* ── PLOTS ── */
    #plots-intro {
      padding: 10rem 2rem 5rem;
      max-width: 760px;
      margin: 0 auto;
    }
    #plots-intro h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 2rem;
    }
    #plots-intro p {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.8;
      color: rgba(245,245,240,0.7);
    }
    #plots-pin { height: 420vh; }
    #plots-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.75rem;
      padding: calc(var(--nav-h) + 2rem) 2rem 2rem;
    }
    .plots-frame {
      position: relative;
      width: min(720px, 90vw);
      aspect-ratio: 720 / 500;
    }
    .plot-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 3px;
    }
    #plot-kc { opacity: 0; }
    #plot-caption {
      position: relative;
      text-align: center;
      width: min(560px, 90vw);
      min-height: 3.5rem;
    }
    .plot-cap { position: absolute; left: 0; right: 0; }
    #plot-cap-kc { opacity: 0; }
    .plot-cap-eyebrow {
      font-size: 0.68rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }
    .plot-cap-text {
      font-size: clamp(0.9rem, 1.3vw, 1rem);
      line-height: 1.7;
      color: rgba(245,245,240,0.7);
    }

    /* ── MOBILE: each short content section gets its own screen ──
       Without this, sections like the CTA and plots intro are well under
       one viewport tall on a phone, so a single inertial swipe can carry
       the reader past an entire heading + paragraph. min-height + flex
       centering makes each section a deliberate "stop." */
    @media (max-width: 640px) {
      #plots-intro,
      #what,
      #cta {
        min-height: 100svh;
        padding-top: 4rem;
        padding-bottom: 4rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      #plots-intro,
      #what,
      #symptoms {
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }
    }

    /* ── REDUCED MOTION ── */
    @media (prefers-reduced-motion: reduce) {
      #vision { height: 100vh; }
      #scroll-hint { display: none; }
      .symptom-card {
        opacity: 1;
        translate: none;
      }
      #plots-pin { height: auto; }
      #plots-sticky { position: static; height: auto; gap: 2rem; padding: 2rem; }
      .plots-frame { aspect-ratio: auto; }
      .plot-img { position: static; height: auto; width: 100%; display: block; }
      #plot-kc { opacity: 1; }
      .plot-cap { position: static; margin-top: 0.75rem; }
      #plot-cap-kc { opacity: 1; }
      #plot-caption { min-height: auto; display: flex; flex-direction: column; gap: 2rem; }
    }
  </style>

  <main id="main-content" tabindex="-1">

  <!-- VISION TRANSITION — animation controlled by GSAP below -->
  <section id="vision" aria-label="Vision simulation">
    <div id="vision-sticky">

      <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden">
        <defs>
          <filter id="kc" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.009 0.007" numOctaves="3" seed="3" result="noise" id="kc-t"/>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" result="warped" id="kc-d"/>
            <feGaussianBlur stdDeviation="0" in="warped" id="kc-b"/>
          </filter>
        </defs>
      </svg>

      <img id="img-clean"  class="vision-img" src="/images/normal_hires.jpg" alt="" aria-hidden="true" />
      <img id="img-warped" class="vision-img" src="/images/normal_hires.jpg" style="filter:url(#kc);opacity:0" alt="" aria-hidden="true" />
      <img id="img-ghost"  class="vision-img" src="/images/normal_hires.jpg" style="opacity:0;mix-blend-mode:screen" alt="" aria-hidden="true" />

      <div id="text-hero">
        <h1 class="hero-heading">{hero.heading}</h1>
        <p class="hero-sub">
          {hero.body}
          <a href="https://nkcf.org/understanding-kc/" class="cite" target="_blank" rel="noopener noreferrer" aria-label="National Keratoconus Foundation (opens in new tab)">NKCF</a>
        </p>
      </div>

      <p class="sr-only">
        A scroll-driven photograph below simulates keratoconus vision: as the page scrolls, the image warps, halos bloom around lights, ghosted copies overlay the scene, and detail blurs in ways that glasses cannot correct. A plain-text description of the condition follows further down the page.
      </p>

      <div class="vision-text" id="text-normal" aria-hidden="true">
        <p class="vision-eyebrow">{vision.labelNormal}</p>
        <p class="vision-desc">{vision.captionNormal}</p>
      </div>

      <div class="vision-text" id="text-kc" aria-hidden="true">
        <p class="vision-eyebrow">{vision.labelKC}</p>
        <p class="vision-desc">{vision.captionKC}</p>
      </div>

      <div id="scroll-hint" aria-hidden="true">
        Scroll
        <div class="arrow"></div>
      </div>
    </div>
  </section>

  <!-- PLOTS: another way to see it -->
  <section id="plots-intro">
    <p class="section-label">Another look</p>
    <h2>{plots.heading}</h2>
    <p>{plots.intro}</p>
  </section>

  <section id="plots-pin" aria-label="Scatter plot comparison">
    <p class="sr-only">
      Two scatter plots are crossfaded as you scroll. With normal vision, every data point is a single dot. With the author's vision while recovering from corneal cross-linking surgery, the same plot appears with every data point tripled into three overlapping dots.
    </p>
    <div id="plots-sticky" aria-hidden="true">
      <div class="plots-frame">
        <img id="plot-normal" class="plot-img" src="/images/plot_normal.png" alt="" />
        <img id="plot-kc" class="plot-img" src="/images/plot_kc.png" alt="" />
      </div>
      <div id="plot-caption">
        <div id="plot-cap-normal" class="plot-cap">
          <p class="plot-cap-eyebrow">{plots.labelNormal}</p>
          <p class="plot-cap-text">{plots.captionNormal}</p>
        </div>
        <div id="plot-cap-kc" class="plot-cap">
          <p class="plot-cap-eyebrow">{plots.labelKC}</p>
          <p class="plot-cap-text">{plots.captionKC}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS KC -->
  <section id="what">
    <p class="section-label">The condition</p>
    <h2>{what.heading}</h2>
    <p>
      {what.para1}
      <a href="https://nkcf.org/about-keratoconus/" class="cite" target="_blank" rel="noopener noreferrer" aria-label="NKCF (opens in new tab)">NKCF</a>
      <a href="https://www.mayoclinic.org/diseases-conditions/keratoconus/symptoms-causes/syc-20351352" class="cite" target="_blank" rel="noopener noreferrer" aria-label="Mayo Clinic (opens in new tab)">Mayo Clinic</a>
    </p>
    <p>
      {what.para2}
      <a href="https://www.mayoclinic.org/diseases-conditions/keratoconus/diagnosis-treatment/drc-20351357" class="cite" target="_blank" rel="noopener noreferrer" aria-label="Mayo Clinic (opens in new tab)">Mayo Clinic</a>
      <a href="https://nkcf.org/about-keratoconus/" class="cite" target="_blank" rel="noopener noreferrer" aria-label="NKCF (opens in new tab)">NKCF</a>
    </p>
  </section>

  <!-- SYMPTOMS -->
  <section id="symptoms">
    <div class="symptoms-inner">
      <p class="section-label">What it feels like</p>
      <h2>Symptoms of keratoconus</h2>
      <div class="symptom-grid">
        {symptoms.map(s => (
          <div class="symptom-card">
            <h3>{s.heading}</h3>
            <p>{s.body} <a href="https://nkcf.org/about-keratoconus/keratoconus-symptoms/" class="cite" target="_blank" rel="noopener noreferrer" aria-label="NKCF (opens in new tab)">NKCF</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXTRA SECTIONS -->
  {extraSections.map(s => (
    <section class="extra-section">
      {s.label && <p class="section-label">{s.label}</p>}
      <h2>{s.heading}</h2>
      {s.paragraphs.map(p => <p>{p}</p>)}
    </section>
  ))}

  <!-- CTA -->
  <section id="cta">
    <p class="section-label">Take action</p>
    <h2>{cta.heading}</h2>
    <p>{cta.body}</p>
    <div class="cta-actions">
      <a class="btn" href="https://www.nkcf.org" target="_blank" rel="noopener" aria-label="National Keratoconus Foundation (opens in new tab)">
        National Keratoconus Foundation
      </a>
      <a class="btn btn-ghost" href="/about">
        Read my story
      </a>
    </div>
  </section>

  </main>

  <Fragment slot="footer-extra">
    <p style="font-size:0.7rem">
      Vision simulation based on
      <a href="https://www.flickr.com/photos/sprengben/5126320106/" target="_blank" rel="noopener" aria-label="&ldquo;Times Square Rain Dance&rdquo; by Spreng Ben (opens in new tab)">&ldquo;Times Square Rain Dance&rdquo; by Spreng Ben</a>,
      used under <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" target="_blank" rel="noopener" aria-label="CC BY-NC-SA 3.0 (opens in new tab)">CC BY-NC-SA 3.0</a>.
      KC simulation adapted from <a href="https://www.livingwithkeratoconus.com" target="_blank" rel="noopener" aria-label="livingwithkeratoconus.com (opens in new tab)">livingwithkeratoconus.com</a>.
    </p>
  </Fragment>

</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    // ── Scroll hint ──────────────────────────────────────────────
    gsap.to('#scroll-hint .arrow', {
      scaleY: 0.5,
      transformOrigin: 'top center',
      duration: 0.8,
      repeat: -1,
      yoyo: true,
      ease: 'power1.inOut',
    });

    gsap.to('#scroll-hint', {
      opacity: 0,
      scrollTrigger: {
        trigger: '#vision',
        start: 'top top',
        end: '+=120',
        scrub: true,
      },
    });

    // ── Vision transition ────────────────────────────────────────
    const kcDisp = document.getElementById('kc-d');
    const kcBlur = document.getElementById('kc-b');

    const visionTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#vision',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.5,
      },
    });

    visionTl
      // hero fades out as scroll begins
      .to('#text-hero',    { opacity: 0, duration: 0.12 }, 0)
      // "Normal" label appears — holds for a full viewport+ before fading
      .to('#text-normal',  { opacity: 1, duration: 0.07 }, 0.12)
      .to('#text-normal',  { opacity: 0, duration: 0.07 }, 0.55)
      // image degrades
      .to(kcDisp, { attr: { scale: 8 },          duration: 0.45, ease: 'power1.in' }, 0.62)
      .to(kcBlur, { attr: { stdDeviation: 0.6 }, duration: 0.45, ease: 'power1.in' }, 0.62)
      .to('#img-clean',  { filter: 'blur(3px)',   duration: 0.45, ease: 'power1.in' }, 0.62)
      .to('#img-warped', { opacity: 0.35,          duration: 0.45 }, 0.62)
      .to('#img-ghost',  { opacity: 0.6, x: 20, y: 11, duration: 0.36 }, 0.66)
      // KC caption fades in near the end of degradation
      .to('#text-kc',    { opacity: 1, duration: 0.07 }, 1.00)
      .to({}, { duration: 0.55 });

    // ── Plot crossfade ───────────────────────────────────────────
    const plotTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#plots-pin',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1,
      },
    });
    plotTl
      .to({}, { duration: 0.4 })
      .to('#plot-normal',     { opacity: 0, duration: 0.2 }, '>')
      .to('#plot-kc',         { opacity: 1, duration: 0.2 }, '<')
      .to('#plot-cap-normal', { opacity: 0, duration: 0.15 }, '<')
      .to('#plot-cap-kc',     { opacity: 1, duration: 0.15 }, '<0.05')
      .to({}, { duration: 0.4 });

    // ── Symptom cards stagger ────────────────────────────────────
    gsap.to('.symptom-card', {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '.symptom-grid',
        start: 'top 80%',
      },
    });

    // ── Nav reveal after vision section ─────────────────────────
    // onEnter/onLeaveBack instead of toggleClass — toggleClass ties
    // visibility to the "active" zone and hides the nav once the
    // vision section fully scrolls past.
    ScrollTrigger.create({
      trigger: '#vision',
      start: 'bottom 80%',
      onEnter:     () => document.getElementById('site-nav')?.classList.add('nav-visible'),
      onLeaveBack: () => document.getElementById('site-nav')?.classList.remove('nav-visible'),
    });

  } else {
    // Show KC effect as a static image — no animation, but users still see what KC looks like
    const kcDisp = document.getElementById('kc-d');
    const kcBlur = document.getElementById('kc-b');
    if (kcDisp) kcDisp.setAttribute('scale', '8');
    if (kcBlur) kcBlur.setAttribute('stdDeviation', '0.6');

    const imgWarped = document.getElementById('img-warped') as HTMLElement;
    const imgGhost  = document.getElementById('img-ghost')  as HTMLElement;
    if (imgWarped) imgWarped.style.opacity = '0.35';
    if (imgGhost)  { imgGhost.style.opacity = '0.6'; imgGhost.style.transform = 'translate(20px, 11px)'; }


    document.querySelectorAll<HTMLElement>('.symptom-card').forEach(el => {
      el.style.opacity = '1';
      el.style.translate = 'none';
    });
  }
</script>
