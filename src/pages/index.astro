---
import Base from '../layouts/Base.astro';

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  CONTENT — edit text freely here
//  Don't touch anything below the closing ━━━ line.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

const hero = {
  eyebrow: 'Keratoconus Awareness',
  sub: '1 in 2,000 people live with a progressive eye disease that quietly steals their vision. Scroll to experience it.',
};

const vision = {
  captionNormal: 'This is how most people see the world — sharp, clear, defined.',
  captionKC: "For someone with keratoconus, light scatters, halos form, and even the best glasses can't fully correct it.",
};

const what = {
  heading: 'When the cornea stops holding its shape',
  para1: 'Keratoconus (KC) is a progressive disorder where the cornea — normally a dome — gradually thins and bulges outward into a cone shape. As it distorts, it bends light incorrectly, causing blurred and distorted vision that worsens over years.',
  para2: 'It typically begins in the late teens or early twenties and can progress through the thirties. In severe cases, a corneal transplant becomes the only option. Caught early, specialty contact lenses and corneal cross-linking can slow or halt progression.',
};

// Add or remove cards by copying/deleting a { heading, body } object.
const symptoms = [
  { heading: 'Ghosting & doubling',          body: 'Multiple ghost images overlay a single object, especially under bright light.' },
  { heading: 'Halos & streaks',               body: 'Light sources bloom into starbursts and smeared streaks at night.' },
  { heading: "Blur that glasses can't fix",   body: 'Standard prescriptions stop correcting vision as the cone shape progresses.' },
  { heading: 'Light sensitivity',             body: 'Oncoming headlights, screens, and sunlight become overwhelming and painful.' },
  { heading: 'Frequent prescription changes', body: 'Rapid shifts in astigmatism that no single pair of glasses keeps up with.' },
  { heading: 'Eye rubbing',                   body: 'Chronic itching leads to rubbing — associated with accelerated corneal thinning.' },
];

const cta = {
  heading: 'Early diagnosis changes everything',
  body: "KC is often misdiagnosed as astigmatism for years. If any of this looked familiar, ask your eye doctor about corneal topography.",
};

// Add sections here to insert prose between Symptoms and the CTA.
// Each section gets a small label, a heading, and as many paragraphs as you want.
// Leave this empty ([]) and nothing renders.
const extraSections: { label?: string; heading: string; paragraphs: string[] }[] = [
  // {
  //   label: 'My experience',
  //   heading: 'Living with KC',
  //   paragraphs: [
  //     'First paragraph...',
  //     'Second paragraph...',
  //   ],
  // },
];

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
---

<Base title="Keratoconus — See What We See">

  <style>
    /* ── HERO ── */
    #hero {
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    #hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.85) 100%);
      z-index: 1;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background: #0a0a0a url('/images/normal_hires.jpg') center/cover no-repeat;
      z-index: 0;
      opacity: 0.25;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-eyebrow {
      font-size: clamp(0.65rem, 1.2vw, 0.85rem);
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
      opacity: 0;
    }

    .hero-headline {
      font-size: clamp(2.8rem, 7vw, 6rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      opacity: 0;
    }

    .hero-headline em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-sub {
      margin-top: 1.5rem;
      font-size: clamp(1rem, 1.8vw, 1.25rem);
      color: rgba(245,245,240,0.6);
      max-width: 44ch;
      line-height: 1.6;
      opacity: 0;
    }

    .scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      translate: -50% 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: rgba(245,245,240,0.35);
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0;
    }

    .scroll-hint .arrow {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, rgba(245,245,240,0.35), transparent);
    }

    /* ── VISION SECTION ── */
    #vision {
      position: relative;
      height: 300vh;
    }

    #vision-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vision-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .vision-label {
      position: absolute;
      z-index: 10;
      font-size: clamp(0.65rem, 1.1vw, 0.8rem);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 0.4em 0.9em;
      border: 1px solid currentColor;
      top: 2rem;
      right: 2rem;
      opacity: 0;
      pointer-events: none;
    }

    #label-normal {
      color: var(--white);
      background: rgba(0,0,0,0.55);
      backdrop-filter: blur(4px);
    }
    #label-kc {
      color: var(--accent);
      background: rgba(0,0,0,0.55);
      backdrop-filter: blur(4px);
      border-color: var(--accent);
    }

    .vision-caption {
      position: absolute;
      bottom: 3rem;
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      text-align: center;
      pointer-events: none;
      opacity: 0;
      width: 90%;
      max-width: 520px;
    }

    .vision-caption p {
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      line-height: 1.65;
      color: rgba(245,245,240,0.85);
    }

    /* ── WHAT IS KC ── */
    #what {
      padding: 12rem 2rem;
      max-width: 760px;
      margin: 0 auto;
    }

    .section-label {
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 2rem;
    }

    #what h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 2rem;
    }

    #what p {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.8;
      color: rgba(245,245,240,0.7);
      margin-bottom: 1.25rem;
    }

    /* ── SYMPTOMS ── */
    #symptoms {
      padding: 8rem 2rem;
      background: #111;
    }

    .symptoms-inner {
      max-width: 960px;
      margin: 0 auto;
    }

    #symptoms h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 3rem;
    }

    .symptom-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .symptom-card {
      padding: 1.75rem 1.5rem;
      border: 1px solid rgba(245,245,240,0.08);
      border-radius: 4px;
      opacity: 0;
      translate: 0 24px;
    }

    .symptom-card h3 {
      font-size: 1.05rem;
      margin-bottom: 0.6rem;
      color: var(--accent);
    }

    .symptom-card p {
      font-size: 0.92rem;
      line-height: 1.65;
      color: rgba(245,245,240,0.6);
    }

    /* ── EXTRA SECTIONS ── */
    .extra-section {
      padding: 10rem 2rem;
      max-width: 760px;
      margin: 0 auto;
    }

    .extra-section h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 2rem;
    }

    .extra-section p {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.8;
      color: rgba(245,245,240,0.7);
      margin-bottom: 1.25rem;
    }
    .extra-section p:last-child { margin-bottom: 0; }

    /* ── CTA ── */
    #cta {
      padding: 10rem 2rem;
      text-align: center;
    }

    #cta h2 {
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    #cta p {
      font-size: 1.05rem;
      color: rgba(245,245,240,0.6);
      margin-bottom: 2.5rem;
      line-height: 1.7;
    }

    .btn {
      display: inline-block;
      padding: 0.85em 2em;
      background: var(--accent);
      color: var(--black);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.05em;
      border-radius: 2px;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.85; }
  </style>

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">{hero.eyebrow}</p>
      <h1 class="hero-headline">See What<br /><em>We See</em></h1>
      <p class="hero-sub">{hero.sub}</p>
    </div>
    <div class="scroll-hint">
      Scroll
      <div class="arrow"></div>
    </div>
  </section>

  <!-- VISION TRANSITION — animation controlled by GSAP below -->
  <section id="vision">
    <div id="vision-sticky">

      <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden">
        <defs>
          <filter id="kc" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.009 0.007" numOctaves="3" seed="3" result="noise" id="kc-t"/>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" result="warped" id="kc-d"/>
            <feGaussianBlur stdDeviation="0" in="warped" id="kc-b"/>
          </filter>
        </defs>
      </svg>

      <img id="img-clean"  class="vision-img" src="/images/normal_hires.jpg" alt="Normal vision" />
      <img id="img-warped" class="vision-img" src="/images/normal_hires.jpg" style="filter:url(#kc);opacity:0" alt="" aria-hidden="true" />
      <img id="img-ghost"  class="vision-img" src="/images/normal_hires.jpg" style="opacity:0;mix-blend-mode:screen" alt="" aria-hidden="true" />

      <span class="vision-label" id="label-normal">Normal</span>
      <span class="vision-label" id="label-kc">Keratoconus</span>

      <div class="vision-caption" id="caption-normal">
        <p>{vision.captionNormal}</p>
      </div>
      <div class="vision-caption" id="caption-kc">
        <p>{vision.captionKC}</p>
      </div>
    </div>
  </section>

  <!-- WHAT IS KC -->
  <section id="what">
    <p class="section-label">The condition</p>
    <h2>{what.heading}</h2>
    <p>
      {what.para1}
      <a href="https://nkcf.org/about-keratoconus/" class="cite" target="_blank" rel="noopener noreferrer">NKCF</a>
      <a href="https://www.mayoclinic.org/diseases-conditions/keratoconus/symptoms-causes/syc-20351352" class="cite" target="_blank" rel="noopener noreferrer">Mayo Clinic</a>
    </p>
    <p>
      {what.para2}
      <a href="https://www.mayoclinic.org/diseases-conditions/keratoconus/diagnosis-treatment/drc-20351357" class="cite" target="_blank" rel="noopener noreferrer">Mayo Clinic</a>
      <a href="https://nkcf.org/about-keratoconus/" class="cite" target="_blank" rel="noopener noreferrer">NKCF</a>
    </p>
  </section>

  <!-- SYMPTOMS -->
  <section id="symptoms">
    <div class="symptoms-inner">
      <p class="section-label">What it feels like</p>
      <h2>Symptoms of keratoconus</h2>
      <div class="symptom-grid">
        {symptoms.map(s => (
          <div class="symptom-card">
            <h3>{s.heading}</h3>
            <p>{s.body} <a href="https://nkcf.org/about-keratoconus/keratoconus-symptoms/" class="cite" target="_blank" rel="noopener noreferrer">NKCF</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXTRA SECTIONS -->
  {extraSections.map(s => (
    <section class="extra-section">
      {s.label && <p class="section-label">{s.label}</p>}
      <h2>{s.heading}</h2>
      {s.paragraphs.map(p => <p>{p}</p>)}
    </section>
  ))}

  <!-- CTA -->
  <section id="cta">
    <p class="section-label">Take action</p>
    <h2>{cta.heading}</h2>
    <p>{cta.body}</p>
    <a class="btn" href="https://www.nkcf.org" target="_blank" rel="noopener">
      National Keratoconus Foundation
    </a>
  </section>

  <Fragment slot="footer-extra">
    <p style="font-size:0.7rem;opacity:0.5">
      Vision simulation based on
      <a href="https://www.flickr.com/photos/sprengben/5126320106/" target="_blank" rel="noopener">&ldquo;Times Square Rain Dance&rdquo; by Spreng Ben</a>,
      used under <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" target="_blank" rel="noopener">CC BY-NC-SA 3.0</a>.
      KC simulation adapted from <a href="https://www.livingwithkeratoconus.com" target="_blank" rel="noopener">livingwithkeratoconus.com</a>.
    </p>
  </Fragment>

</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Hero entrance ──────────────────────────────────────────────
  const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  heroTl
    .to('.hero-eyebrow',    { opacity: 1, y: 0, duration: 0.9, delay: 0.3 }, 0)
    .from('.hero-headline', { y: 40, duration: 1 }, 0.2)
    .to('.hero-headline',   { opacity: 1, duration: 1 }, 0.2)
    .to('.hero-sub',        { opacity: 1, y: 0, duration: 0.8 }, 0.6)
    .to('.scroll-hint',     { opacity: 1, duration: 0.6 }, 1.1);

  gsap.to('.scroll-hint .arrow', {
    scaleY: 0.5,
    transformOrigin: 'top center',
    duration: 0.8,
    repeat: -1,
    yoyo: true,
    ease: 'power1.inOut',
  });

  // ── Vision transition ──────────────────────────────────────────
  const kcDisp = document.getElementById('kc-d');
  const kcBlur = document.getElementById('kc-b');

  const visionTl = gsap.timeline({
    scrollTrigger: {
      trigger: '#vision',
      start: 'top top',
      end: 'bottom bottom',
      scrub: 1.5,
    },
  });

  visionTl
    // Phase 1: reveal the crisp label
    .to('#label-normal',   { opacity: 1, duration: 0.15 }, 0)
    .to('#caption-normal', { opacity: 1, duration: 0.15 }, 0)
    // Phase 2: degrade — subtle distortion, mild blur, ghost
    .to('#label-normal',   { opacity: 0, duration: 0.08 }, 0.22)
    .to('#caption-normal', { opacity: 0, duration: 0.08 }, 0.22)
    .to(kcDisp, { attr: { scale: 8 },          duration: 0.55, ease: 'power1.in' }, 0.2)
    .to(kcBlur, { attr: { stdDeviation: 0.6 }, duration: 0.55, ease: 'power1.in' }, 0.2)
    .to('#img-warped', { opacity: 0.35, duration: 0.55 }, 0.2)
    .to('#img-ghost',  { opacity: 0.6, x: 20, y: 11, duration: 0.45 }, 0.25)
    // Phase 3: surface KC label
    .to('#label-kc',   { opacity: 1, duration: 0.12 }, 0.75)
    .to('#caption-kc', { opacity: 1, duration: 0.12 }, 0.78)
    .to({}, { duration: 0.1 });

  // ── Symptom cards stagger ──────────────────────────────────────
  gsap.to('.symptom-card', {
    opacity: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.1,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.symptom-grid',
      start: 'top 80%',
    },
  });
</script>
