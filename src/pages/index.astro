---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Keratoconus — See What We See</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white: #f5f5f0;
      --black: #0a0a0a;
      --accent: #00b4d8;
    }

    html { scroll-behavior: auto; }

    body {
      background: var(--black);
      color: var(--white);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      overflow-x: hidden;
    }

    /* ── HERO ── */
    #hero {
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    #hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.85) 100%);
      z-index: 1;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background: #0a0a0a url('/images/normal_hires.jpg') center/cover no-repeat;
      z-index: 0;
      opacity: 0.25;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-eyebrow {
      font-size: clamp(0.65rem, 1.2vw, 0.85rem);
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
      opacity: 0;
    }

    .hero-headline {
      font-size: clamp(2.8rem, 7vw, 6rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      opacity: 0;
    }

    .hero-headline em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-sub {
      margin-top: 1.5rem;
      font-size: clamp(1rem, 1.8vw, 1.25rem);
      color: rgba(245,245,240,0.6);
      max-width: 44ch;
      line-height: 1.6;
      opacity: 0;
    }

    .scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      translate: -50% 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: rgba(245,245,240,0.35);
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0;
    }

    .scroll-hint .arrow {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, rgba(245,245,240,0.35), transparent);
    }

    /* ── VISION SECTION ── */
    #vision {
      position: relative;
      height: 300vh; /* scroll distance for the pin */
    }

    #vision-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vision-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #img-normal {
      z-index: 1;
    }

    #img-kc {
      z-index: 2;
      clip-path: circle(0% at 50% 50%);
    }

    .vision-label {
      position: absolute;
      z-index: 10;
      font-size: clamp(0.65rem, 1.1vw, 0.8rem);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 0.4em 0.9em;
      border: 1px solid currentColor;
      top: 2rem;
      right: 2rem;
      opacity: 0;
      pointer-events: none;
    }

    #label-normal { color: var(--white); }
    #label-kc { color: var(--accent); }

    .vision-caption {
      position: absolute;
      bottom: 3rem;
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      text-align: center;
      pointer-events: none;
      opacity: 0;
      width: 90%;
      max-width: 520px;
    }

    .vision-caption p {
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      line-height: 1.65;
      color: rgba(245,245,240,0.85);
    }

    /* ── WHAT IS KC ── */
    #what {
      padding: 12rem 2rem;
      max-width: 760px;
      margin: 0 auto;
    }

    .section-label {
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 2rem;
    }

    #what h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: 2rem;
    }

    #what p {
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.8;
      color: rgba(245,245,240,0.7);
      margin-bottom: 1.25rem;
    }

    /* ── SYMPTOMS ── */
    #symptoms {
      padding: 8rem 2rem;
      background: #111;
    }

    .symptoms-inner {
      max-width: 960px;
      margin: 0 auto;
    }

    #symptoms h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 3rem;
    }

    .symptom-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .symptom-card {
      padding: 1.75rem 1.5rem;
      border: 1px solid rgba(245,245,240,0.08);
      border-radius: 4px;
      opacity: 0;
      translate: 0 24px;
    }

    .symptom-card h3 {
      font-size: 1.05rem;
      margin-bottom: 0.6rem;
      color: var(--accent);
    }

    .symptom-card p {
      font-size: 0.92rem;
      line-height: 1.65;
      color: rgba(245,245,240,0.6);
    }

    /* ── CTA ── */
    #cta {
      padding: 10rem 2rem;
      text-align: center;
    }

    #cta h2 {
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    #cta p {
      font-size: 1.05rem;
      color: rgba(245,245,240,0.6);
      margin-bottom: 2.5rem;
      line-height: 1.7;
    }

    .btn {
      display: inline-block;
      padding: 0.85em 2em;
      background: var(--accent);
      color: var(--black);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.05em;
      border-radius: 2px;
      transition: opacity 0.2s;
    }

    .btn:hover { opacity: 0.85; }

    footer {
      padding: 2rem;
      text-align: center;
      font-size: 0.75rem;
      color: rgba(245,245,240,0.25);
      border-top: 1px solid rgba(245,245,240,0.06);
    }
  </style>
</head>
<body>

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Keratoconus Awareness</p>
      <h1 class="hero-headline">See What<br><em>We See</em></h1>
      <p class="hero-sub">
        1 in 2,000 people live with a progressive eye disease that quietly steals their vision.
        Scroll to experience it.
      </p>
    </div>
    <div class="scroll-hint">
      Scroll
      <div class="arrow"></div>
    </div>
  </section>

  <!-- VISION TRANSITION -->
  <section id="vision">
    <div id="vision-sticky">

      <!-- SVG filter: corneal distortion + blur, animated by GSAP -->
      <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden">
        <defs>
          <filter id="kc" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.009 0.007" numOctaves="3" seed="3" result="noise" id="kc-t"/>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" result="warped" id="kc-d"/>
            <feGaussianBlur stdDeviation="0" in="warped" id="kc-b"/>
          </filter>
        </defs>
      </svg>

      <!-- Sharp base image, always full opacity -->
      <img id="img-clean"  class="vision-img" src="/images/normal_hires.jpg" alt="Normal vision" />
      <!-- Distorted+blurred copy via SVG filter, fades in -->
      <img id="img-warped" class="vision-img" src="/images/normal_hires.jpg" style="filter:url(#kc);opacity:0" alt="" aria-hidden="true" />
      <!-- Ghost layer for monocular diplopia, screen blend isolates brights naturally -->
      <img id="img-ghost"  class="vision-img" src="/images/normal_hires.jpg" style="opacity:0;mix-blend-mode:screen" alt="" aria-hidden="true" />

      <span class="vision-label" id="label-normal">Normal</span>
      <span class="vision-label" id="label-kc">Keratoconus</span>

      <div class="vision-caption" id="caption-normal">
        <p>This is how most people see the world — sharp, clear, defined.</p>
      </div>
      <div class="vision-caption" id="caption-kc">
        <p>For someone with keratoconus, light scatters, halos form, and even the best glasses can't fully correct it.</p>
      </div>
    </div>
  </section>

  <!-- WHAT IS KC -->
  <section id="what">
    <p class="section-label">The condition</p>
    <h2>When the cornea stops holding its shape</h2>
    <p>
      Keratoconus (KC) is a progressive disorder where the cornea — normally a dome — gradually thins
      and bulges outward into a cone shape. As it distorts, it bends light incorrectly, causing blurred
      and distorted vision that worsens over years.
    </p>
    <p>
      It typically begins in the late teens or early twenties and can progress through the thirties.
      In severe cases, a corneal transplant becomes the only option. Caught early, specialty contact
      lenses and corneal cross-linking can slow or halt progression.
    </p>
  </section>

  <!-- SYMPTOMS -->
  <section id="symptoms">
    <div class="symptoms-inner">
      <p class="section-label">What it feels like</p>
      <h2>Symptoms of keratoconus</h2>
      <div class="symptom-grid">
        <div class="symptom-card">
          <h3>Ghosting &amp; doubling</h3>
          <p>Multiple ghost images overlay a single object, especially under bright light.</p>
        </div>
        <div class="symptom-card">
          <h3>Halos &amp; streaks</h3>
          <p>Light sources bloom into starbursts and smeared streaks at night.</p>
        </div>
        <div class="symptom-card">
          <h3>Blur that glasses can't fix</h3>
          <p>Standard prescriptions stop correcting vision as the cone shape progresses.</p>
        </div>
        <div class="symptom-card">
          <h3>Light sensitivity</h3>
          <p>Oncoming headlights, screens, and sunlight become overwhelming and painful.</p>
        </div>
        <div class="symptom-card">
          <h3>Frequent prescription changes</h3>
          <p>Rapid shifts in astigmatism that no single pair of glasses keeps up with.</p>
        </div>
        <div class="symptom-card">
          <h3>Eye rubbing</h3>
          <p>Chronic itching and rubbing — a known trigger that accelerates thinning.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta">
    <p class="section-label">Take action</p>
    <h2>Early diagnosis changes everything</h2>
    <p>
      KC is often misdiagnosed as astigmatism for years.<br />
      If any of this looked familiar, ask your eye doctor about corneal topography.
    </p>
    <a class="btn" href="https://www.nkcf.org" target="_blank" rel="noopener">
      National Keratoconus Foundation
    </a>
  </section>

  <footer>
    <p>&copy; 2026 &mdash; Keratoconus awareness. Not medical advice.</p>
    <p style="margin-top:0.5rem;font-size:0.7rem;opacity:0.5">
      Vision simulation based on
      <a href="https://www.flickr.com/photos/sprengben/5126320106/" target="_blank" rel="noopener" style="color:inherit">&ldquo;Times Square Rain Dance&rdquo; by Spreng Ben</a>,
      used under <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" target="_blank" rel="noopener" style="color:inherit">CC BY-NC-SA 3.0</a>.
      KC simulation adapted from <a href="https://www.livingwithkeratoconus.com" target="_blank" rel="noopener" style="color:inherit">livingwithkeratoconus.com</a>.
    </p>
  </footer>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // ── Hero entrance ──────────────────────────────────────────────
    const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    heroTl
      .to('.hero-eyebrow',   { opacity: 1, y: 0, duration: 0.9, delay: 0.3 }, 0)
      .from('.hero-headline', { y: 40, duration: 1 }, 0.2)
      .to('.hero-headline',  { opacity: 1, duration: 1 }, 0.2)
      .to('.hero-sub',       { opacity: 1, y: 0, duration: 0.8 }, 0.6)
      .to('.scroll-hint',    { opacity: 1, duration: 0.6 }, 1.1);

    // keep scroll-hint bobbing
    gsap.to('.scroll-hint .arrow', {
      scaleY: 0.5,
      transformOrigin: 'top center',
      duration: 0.8,
      repeat: -1,
      yoyo: true,
      ease: 'power1.inOut',
    });

    // ── Vision transition ──────────────────────────────────────────
    // Targets for SVG filter attribute animation
    const kcDisp  = document.getElementById('kc-d');
    const kcBlur  = document.getElementById('kc-b');

    const visionTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#vision',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.5,
      },
    });

    visionTl
      // Phase 1 (0–0.15): reveal the crisp normal image label
      .to('#label-normal',   { opacity: 1, duration: 0.15 }, 0)
      .to('#caption-normal', { opacity: 1, duration: 0.15 }, 0)

      // Phase 2 (0.2–0.75): degrade — subtle distortion, mild blur, ghost, and headlight bloom
      .to('#label-normal',   { opacity: 0, duration: 0.08 }, 0.22)
      .to('#caption-normal', { opacity: 0, duration: 0.08 }, 0.22)
      // Less swirl, more ghosting
      .to(kcDisp, { attr: { scale: 8 },          duration: 0.55, ease: 'power1.in' }, 0.2)
      .to(kcBlur, { attr: { stdDeviation: 0.6 }, duration: 0.55, ease: 'power1.in' }, 0.2)
      .to('#img-warped', { opacity: 0.35, duration: 0.55 }, 0.2)
      .to('#img-ghost',  { opacity: 0.6, x: 20, y: 11, duration: 0.45 }, 0.25)

      // Phase 3 (0.75–0.9): surface the KC label
      .to('#label-kc',   { opacity: 1, duration: 0.12 }, 0.75)
      .to('#caption-kc', { opacity: 1, duration: 0.12 }, 0.78)

      // hold at end
      .to({}, { duration: 0.1 });

    // ── Symptom cards stagger ──────────────────────────────────────
    gsap.to('.symptom-card', {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '.symptom-grid',
        start: 'top 80%',
      },
    });
  </script>
</body>
</html>
