---
import Base from '../layouts/Base.astro';

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  CONTENT — edit text freely here
//  Don't touch anything below the closing ━━━ line.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

const page = {
  title: 'Advocacy — Keratoconus Awareness',
  heading: 'My Approach to Advocacy',
  intro: 'A sentence or two on what drives you — what advocacy means to you personally.',
};

// Add or remove sections by copying/deleting a { heading, paragraphs } block.
const sections = [
  {
    heading: 'Why awareness matters',
    paragraphs: [
      'Your thoughts on the gap between how common KC is and how little most people know about it.',
      'What you wish someone had told you — or told your doctors — earlier.',
    ],
  },
  {
    heading: 'What I try to do',
    paragraphs: [
      'How you approach conversations about KC — with friends, family, doctors, or online.',
    ],
  },
  {
    heading: 'What you can do',
    paragraphs: [
      'Concrete things a reader can do: share this site, mention KC to their eye doctor, donate to NKCF, etc.',
    ],
  },
];

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
---

<Base title={page.title}>

  <style>
    #advocacy {
      padding: calc(var(--nav-h) + 6rem) 2rem 10rem;
      max-width: 680px;
      margin: 0 auto;
    }

    #advocacy h1 {
      font-size: clamp(2.2rem, 5vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }

    .page-intro {
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      color: rgba(245,245,240,0.6);
      line-height: 1.75;
      margin-bottom: 4.5rem;
      max-width: 52ch;
    }

    .content-section {
      margin-bottom: 3rem;
    }

    .content-section h2 {
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.85rem;
    }

    .content-section p {
      font-size: clamp(0.95rem, 1.4vw, 1.05rem);
      line-height: 1.85;
      color: rgba(245,245,240,0.7);
      margin-bottom: 0.85rem;
    }
    .content-section p:last-child { margin-bottom: 0; }
  </style>

  <main id="advocacy" aria-labelledby="advocacy-heading">
    <span id="main-content" tabindex="-1" class="sr-only"></span>
    <h1 id="advocacy-heading">{page.heading}</h1>
    <p class="page-intro">{page.intro}</p>
    {sections.map(section => (
      <section class="content-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map(p => <p>{p}</p>)}
      </section>
    ))}
  </main>

</Base>
